{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "wisprflow": {
        "type": "remote",
        "url": "https://api.wisprflow.ai/connect/mcp",
        "disabled": false
      }
    }
  },
  "default_agent": "project-manager",
  "agents": {
    "plan": { "disabled": true },
    "build": { "model": "openai/gpt-5.6-luna#max", "color": "#2B7FFF" }
  }
}
